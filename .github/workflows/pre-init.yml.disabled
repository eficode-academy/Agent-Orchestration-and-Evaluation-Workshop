name: Pre Initialization

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  prepare-template-repository:
    if: github.event.repository.is_template == true && github.event.repository.name != 'Agent-RepoTest' && github.actor != 'github-actions[bot]' && github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Verify init workflow exists
        run: |
          set -euo pipefail

          if [[ ! -f ".github/workflows/init.yml" ]]; then
            echo "Expected .github/workflows/init.yml to exist before pre-init runs."
            exit 1
          fi

      - name: Self-delete pre-init workflow
        run: |
          set -euo pipefail
          rm -f ".github/workflows/pre-init.yml"

      - name: Remove workshop slides
        run: |
          set -euo pipefail
          rm -rf "slides"

      - name: Remove instructor section from README
        run: |
          set -euo pipefail

          start="<!-- pre-init:instructors:start -->"
          end="<!-- pre-init:instructors:end -->"
          temporary_file="$(mktemp)"
          trap 'rm -f "$temporary_file"' EXIT

          awk -v start="$start" -v end="$end" '
            $0 == start { starts++; removing = 1; next }
            $0 == end { ends++; removing = 0; skip_separator = 1; next }
            skip_separator {
              skip_separator = 0
              if ($0 == "") next
            }
            !removing { print }
            END {
              if (starts != 1 || ends != 1 || removing) {
                print "Expected exactly one delimited instructor section in README.md" > "/dev/stderr"
                exit 1
              }
            }
          ' README.md > "$temporary_file"

          mv "$temporary_file" README.md
          trap - EXIT

      - name: Remove instructor guide
        run: |
          set -euo pipefail
          rm -f "INSTRUCTORS.md"

      - name: Remove code owners
        run: |
          set -euo pipefail
          rm -f "CODEOWNERS"

      - name: Rewrite history to one initial commit
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          default_branch="${{ github.event.repository.default_branch }}"

          git checkout --orphan pre-init-squashed
          git add -A
          git commit -m "Initialize repository state"
          git branch -M "$default_branch"
          git push --force origin "$default_branch"
